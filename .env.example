# Copy to .env and fill in. Never commit .env.

# Used to encrypt JWTs and Payload's own secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local Postgres 16 (Homebrew). The Homebrew superuser is your macOS username.
# NOTE: dev uses Drizzle `push`; NEVER point this at a database you also run
# `payload migrate` against — Payload writes a `payload-migrations` row with
# batch -1 in push mode and will warn that data loss will occur.
DATABASE_URI=postgres://localhost:5432/sutoreido_dev

# Separate database used only to generate migrations for production.
DATABASE_URI_SHADOW=postgres://localhost:5432/sutoreido_shadow

# Public origin, used for invoice share links in emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret for scheduled runs. Vercel sends it as `Authorization: Bearer <secret>`
# on cron invocations; /api/cron/bill rejects anything else. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Email (phase 2) ---
# Mail is only sent when BOTH of these are set. With either missing, Payload
# writes messages to the server log instead, which is the safe default for
# testing. Resend requires a verified domain before it will send at all, and
# recommends a subdomain so invoice deliverability is isolated:
#   invoices@invoices.example.com
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=
#
# SAFETY GUARD. Set this while testing and EVERY message goes here instead of the
# real recipient, with the intended address named in the subject. Your database
# holds real client addresses, so leave this set until you are certain.
# EMAIL_REDIRECT_TO=

# --- Optional: seed with your own details instead of the demo values ---
# scripts/seed.ts is committed, so it contains only fictional data. Set these
# locally (this file's real counterpart, .env, is gitignored) to seed your own.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_TRADING_NAME=
# SEED_ABN=
# SEED_BUSINESS_EMAIL=
# SEED_AU_BSB=
# SEED_AU_ACCOUNT=
# SEED_NZ_ACCOUNT=
# SEED_CLIENT_A=
# SEED_CLIENT_B=
